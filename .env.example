# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskdb
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/taskdb?schema=public

# Backend
PORT=6000
NODE_ENV=development

# Gemini API — used to infer a task's required skills from its title on creation
# when none are provided. Optional: if GEMINI_API_KEY is unset, inference is
# skipped and tasks are created without skills. GEMINI_MODEL defaults to gemini-3.5-flash.
# NOTE: Google deprecates/retires Gemini model ids often — a stale GEMINI_MODEL causes a
# 404 ("no longer available") and inference falls back to no skills. If that happens, set
# GEMINI_MODEL to a current model from https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Frontend
# Base URL the browser uses for API calls, baked in at build time. Keep this a
# *relative* path so calls hit the frontend's own origin and are proxied to the
# backend (nginx `/api` in the container; the Vite dev server proxy in Option B).
# Do NOT use an absolute `http://localhost:6000/...` URL — browsers block port
# 6000 as an "unsafe port" (X11), so API calls would fail with ERR_UNSAFE_PORT.
VITE_API_URL=/api
